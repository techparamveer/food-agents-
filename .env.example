# Copy to .env.local and fill in. Never commit .env.local.
# Real keys live at ~/.config/comeda/env:  cp ~/.config/comeda/env .env.local

# Google Places API (New): nearby restaurants, distance, rating, hours, price level.
GOOGLE_PLACES_API_KEY=

# Gemini with Google Search grounding: cost estimates, catering menus, delivery fees, planner chat.
GEMINI_API_KEY=
# Optional: Gemini model for restaurant estimates (default gemini-3.8-flash).
# GEMINI_MODEL=

# Optional, for organiser sign-in later. The demo runs without them.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
