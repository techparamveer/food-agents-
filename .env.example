# Copy to .env.local and fill in. Never commit .env.local.
# Real keys live at ~/.config/comeda/env:  cp ~/.config/comeda/env .env.local

# Google Places API (New): nearby restaurants, distance, rating, hours, price level.
GOOGLE_PLACES_API_KEY=

# Gemini with Google Search grounding: cost estimates, catering menus, delivery fees, planner chat.
GEMINI_API_KEY=
# Optional: override the model, or point at a proxy/mock.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Supabase: organiser sign-in and event data. The demo (/demo) runs without them.
# Get both with: supabase projects api-keys --project-ref <ref>  (use the publishable key, never the secret one)
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: the public URL magic links point at. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server only: lets the Places/Gemini cache use the api_cache table instead of temp files.
# App data never uses it; every event query runs as the signed-in organiser under RLS.
# SUPABASE_SECRET_KEY=
